# Optional: used only by live search workflows outside the deterministic CLI path.
TAVILY_API_KEY=replace-with-your-real-key

# Optional 1Password reference for local private workspaces.
ONEPASSWORD_TAVILY_REFERENCE=op://your-vault/your-item/your-field

# Live integration tests are disabled by default.
ONLINE_MEDIA_ENABLE_LIVE_DOWNLOADS=0
ONLINE_MEDIA_ENABLE_LIVE_ASR=0
ONLINE_MEDIA_ENABLE_LIVE_SEARCH=0

# Optional ASR configuration.
ONLINE_MEDIA_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ONLINE_MEDIA_ASR_PYTHON=/path/to/python-with-qwen-asr
